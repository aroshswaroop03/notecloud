option_settings:
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx

files:
  "/etc/nginx/conf.d/https_redirect.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      server {
        listen 80;
        # The ALB terminates SSL and forwards to the instance on port 80,
        # setting X-Forwarded-Proto. Only redirect requests that did NOT
        # already arrive over HTTPS — otherwise every request loops forever.
        if ($http_x_forwarded_proto != 'https') {
          return 301 https://$host$request_uri;
        }
      }
